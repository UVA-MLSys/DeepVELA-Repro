{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment.schema.json",
  "title": "Experiment schema module",
  "$comment": "Each $defs entry preserves one complete schema from the original expanded package.",
  "$defs": {
    "experiment_condition": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "experiment-condition.schema.json",
      "title": "Experiment condition",
      "type": "object",
      "required": [
        "condition_id",
        "trial_id",
        "controller_realization",
        "benchmark_readiness_condition",
        "withheld_ontology_elements",
        "agent_configuration",
        "source_access",
        "tool_access",
        "budgets",
        "intervention_policy"
        ,"condition_digest"
      ],
      "properties": {
        "condition_id": {
          "type": "string"
        },
        "trial_id": {
          "type": "string"
        },
        "controller_realization": {
          "enum": [
            "ordinary_prompt",
            "procedural_skill",
            "external_harness",
            "graph_orchestrated",
            "other"
          ]
        },
        "benchmark_readiness_condition": {
          "type": "string"
        },
        "withheld_ontology_elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visible_ontology_elements": {"type": "array", "items": {"type": "string"}},
        "visible_source_ids": {"type": "array", "items": {"type": "string"}},
        "hidden_source_ids": {"type": "array", "items": {"type": "string"}},
        "agent_configuration": {
          "type": "object"
        },
        "source_access": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool_access": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hardware_environment_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budgets": {
          "type": "object"
        },
        "intervention_policy": {
          "type": "object"
        },
        "network_policy": {
          "enum": ["disabled", "allowlisted", "unrestricted_recorded"]
        },
        "filesystem_policy": {
          "enum": ["condition_workspace_only", "allowlisted_read_only", "unrestricted_recorded"]
        },
        "prompt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
        "skill_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
        "visible_bundle_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
        "condition_digest": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "created_at": {"type": "string"}
      }
    },
    "assessment_seal": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "assessment-seal.schema.json",
      "title": "Independent benchmark assessment seal",
      "type": "object",
      "required": [
        "seal_id",
        "assessment_id",
        "assessment_sha256",
        "assessor_identity",
        "independent_of_execution",
        "reviewed_at"
      ],
      "properties": {
        "seal_id": {"type": "string"},
        "assessment_id": {"type": "string"},
        "assessment_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "assessor_identity": {"type": "string", "minLength": 1},
        "independent_of_execution": {"const": true},
        "review_notes": {"type": "string"},
        "reviewed_at": {"type": "string"}
      }
    },
    "condition_bundle_manifest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "condition-bundle-manifest.schema.json",
      "title": "Materialized controlled-condition bundle",
      "type": "object",
      "required": ["condition_id", "files", "withheld_paths", "isolation_verified", "bundle_sha256", "created_at"],
      "properties": {
        "condition_id": {"type": "string"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256", "size_bytes"],
            "properties": {
              "path": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
              "size_bytes": {"type": "integer", "minimum": 0}
            }
          }
        },
        "withheld_paths": {"type": "array", "items": {"type": "string"}},
        "isolation_verified": {"type": "boolean"},
        "bundle_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "created_at": {"type": "string"}
      }
    },
    "trial_summary": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "trial-summary.schema.json",
      "title": "Trial summary",
      "type": "object",
      "required": [
        "schema_version",
        "trial_id",
        "condition_id",
        "campaign_id",
        "controller_realization",
        "benchmark_readiness_score",
        "target_count",
        "disposition_counts",
        "reproduction_quality",
        "evidence_coverage",
        "tool_calls",
        "retries",
        "errors",
        "human_interventions",
        "timing_seconds",
        "invalidation_outcomes",
        "source_digests",
        "generated_at"
      ],
      "properties": {
        "trial_id": {
          "type": "string"
        },
        "condition_id": {
          "type": "string"
        },
        "campaign_id": {
          "type": "string"
        },
        "schema_version": {"const": "1.0"},
        "controller_realization": {"type": "string"},
        "benchmark_readiness_score": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
        "target_count": {"type": "integer", "minimum": 0},
        "disposition_counts": {
          "type": "object",
          "required": ["accepted", "rejected", "inconclusive", "blocked"],
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "reproduction_quality": {
          "type": "object",
          "required": ["comparisons", "passed", "failed", "inconclusive", "mean_absolute_percentage_difference", "maximum_absolute_percentage_difference"],
          "properties": {
            "comparisons": {"type": "integer", "minimum": 0},
            "passed": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0},
            "inconclusive": {"type": "integer", "minimum": 0},
            "mean_absolute_percentage_difference": {"type": ["number", "null"], "minimum": 0},
            "maximum_absolute_percentage_difference": {"type": ["number", "null"], "minimum": 0}
          }
        },
        "evidence_coverage": {
          "type": "object",
          "required": ["required_obligations", "verified_obligations", "obligation_ratio", "required_artifact_roles", "present_artifact_roles", "artifact_role_ratio"],
          "properties": {
            "required_obligations": {"type": "integer", "minimum": 0},
            "verified_obligations": {"type": "integer", "minimum": 0},
            "obligation_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "required_artifact_roles": {"type": "integer", "minimum": 0},
            "present_artifact_roles": {"type": "integer", "minimum": 0},
            "artifact_role_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
          }
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "human_interventions": {
          "type": "integer",
          "minimum": 0
        },
        "timing_seconds": {
          "type": "object"
        },
        "resource_use": {
          "type": "object"
        },
        "invalidation_outcomes": {
          "type": "object"
        },
        "source_digests": {"type": "object", "additionalProperties": {"type": "string"}},
        "generated_at": {"type": "string"}
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/experiment_condition"
    },
    {
      "$ref": "#/$defs/assessment_seal"
    },
    {
      "$ref": "#/$defs/condition_bundle_manifest"
    },
    {
      "$ref": "#/$defs/trial_summary"
    }
  ]
}
