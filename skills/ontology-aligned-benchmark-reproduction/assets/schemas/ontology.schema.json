{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ontology.schema.json",
  "title": "Ontology schema module",
  "$comment": "Each $defs entry preserves one complete schema from the original expanded package.",
  "$defs": {
    "source_record": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "source-record.schema.json",
      "title": "Authoritative source record",
      "type": "object",
      "required": [
        "source_id",
        "title",
        "authority_role",
        "locator",
        "immutable_identity",
        "retrieved_at",
        "status"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "authority_role": {
          "enum": [
            "benchmark_specification",
            "paper",
            "repository",
            "dataset",
            "checkpoint",
            "evaluator",
            "official_results",
            "documentation",
            "human_decision"
          ]
        },
        "locator": {"type": "string", "minLength": 1},
        "immutable_identity": {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": {
              "enum": ["commit", "tag", "release", "revision", "digest", "doi", "version", "human_decision_id"]
            },
            "value": {"type": "string", "minLength": 1}
          }
        },
        "retrieved_at": {"type": "string"},
        "content_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
        "supports_element_ids": {"type": "array", "items": {"type": "string"}},
        "supports_obligation_ids": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["resolved", "unresolved", "conflicted"]}
      }
    },
    "ontology_element": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ontology-element.schema.json",
      "title": "Ontology element",
      "type": "object",
      "required": [
        "element_id",
        "category",
        "identity",
        "authority_type",
        "source_ids",
        "status"
      ],
      "properties": {
        "element_id": {
          "type": "string"
        },
        "category": {
          "enum": [
            "software_environment",
            "problem_specification",
            "dataset",
            "performance_metrics",
            "reference_solution",
            "documentation"
          ]
        },
        "identity": {
          "type": "string"
        },
        "authority_type": {
          "enum": [
            "human_decision",
            "authoritative_source_fact",
            "evidence_derived_fact",
            "unresolved"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields": {
          "type": "object"
        },
        "status": {
          "enum": [
            "resolved",
            "unresolved",
            "conflicted"
          ]
        }
      }
    },
    "workload_obligation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "workload-obligation.schema.json",
      "title": "Workload obligation",
      "type": "object",
      "required": [
        "obligation_id",
        "predicate",
        "severity",
        "source_ids",
        "target_ids",
        "required_evidence_roles",
        "status"
      ],
      "properties": {
        "obligation_id": {
          "type": "string"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "required",
            "advisory"
          ]
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "target_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "required_evidence_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "verified",
            "failed",
            "unresolved",
            "stale"
          ]
        }
      }
    },
    "implementation_binding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "implementation-binding.schema.json",
      "title": "Implementation binding",
      "type": "object",
      "required": [
        "binding_id",
        "obligation_ids",
        "binding_type",
        "identity",
        "source_ids"
      ],
      "properties": {
        "binding_id": {
          "type": "string"
        },
        "obligation_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "binding_type": {
          "enum": [
            "code",
            "configuration",
            "transformation",
            "environment",
            "command",
            "evaluator"
          ]
        },
        "identity": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "effective_configuration": {
          "type": "object"
        },
        "permitted_transformations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ontology_relation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ontology-relation.schema.json",
      "title": "Typed ontology relation",
      "type": "object",
      "required": ["relation_id", "relation_type", "from_id", "from_type", "to_id", "to_type"],
      "properties": {
        "relation_id": {"type": "string"},
        "relation_type": {
          "enum": [
            "supports",
            "requires",
            "depends_on",
            "implemented_by",
            "planned_by",
            "consumes",
            "produces",
            "verifies",
            "compares",
            "supports_decision"
          ]
        },
        "from_id": {"type": "string"},
        "from_type": {"type": "string"},
        "to_id": {"type": "string"},
        "to_type": {"type": "string"}
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/source_record"
    },
    {
      "$ref": "#/$defs/ontology_element"
    },
    {
      "$ref": "#/$defs/workload_obligation"
    },
    {
      "$ref": "#/$defs/implementation_binding"
    },
    {
      "$ref": "#/$defs/ontology_relation"
    }
  ]
}
